FROM ubuntu:22.04 AS base

ARG GPDB_SRC="/home/gpadmin/gpdb_src/"

COPY ./README.Ubuntu.bash $GPDB_SRC
RUN DEBIAN_FRONTEND=noninteractive $GPDB_SRC/README.Ubuntu.bash
RUN apt install -y libxslt1-dev

COPY ./ $GPDB_SRC
WORKDIR $GPDB_SRC

ENV CFLAGS="-O0 -Wno-deprecated-declarations"

RUN CC="clang" CXX="clang++" CXXFLAGS="$CFLAGS" \
    ./configure --enable-gpperfmon --with-gssapi --enable-mapreduce \
                --enable-orafce --enable-ic-proxy --enable-orca --with-libxml \
                --with-pythonsrc-ext --with-uuid=e2fs --with-pgport=5432 \
                --enable-debug-extensions --with-gssapi --enable-cassert \
                --enable-debug --enable-depend --with-perl --with-python \
                --with-libxslt --with-openssl --with-pam --with-ldap

RUN make -s -j`nproc`
