         1 |         2 | 1401-08-01 00:00:00 |         2 |       700 |        0 |          .0000000 |      1400.0000000 |        44.0000000
         1 |         2 | 1401-08-01 00:00:00 |         2 |       800 |        0 |          .0000000 |      1600.0000000 |        44.0000000
         1 |        17 | 1401-08-01 00:00:00 |         2 |       500 |        0 |         2.0000000 |      1000.0000000 |        64.0000000
         1 |        17 | 1401-08-01 00:00:00 |         2 |       600 |        0 |          .0000000 |      1200.0000000 |        33.0000000
