CREATE
CREATE EXTENSION gp_internal_tools;
CREATE

CREATE OR REPLACE FUNCTION gp_mock_cdbdispatchcommand(amount int) RETURNS SETOF text AS '@abs_srcdir@/../regress/regress.so', 'gp_mock_cdbdispatchcommand' LANGUAGE C;
CREATE
-- end_ignore

-- Remember PID of the backend under load.
1: CREATE TABLE process_pid AS SELECT pg_backend_pid() AS pid;
CREATE 1

-- Freeze coordinator's session after it reads results from segments.
SELECT gp_inject_fault('check_dispatch_result_end', 'suspend', dbid) FROM gp_segment_configuration WHERE role = 'p' AND content = -1;
 gp_inject_fault 
-----------------
 Success:        
(1 row)

-- Send the heavy query.
1&: SELECT count(*) FROM gp_mock_cdbdispatchcommand(1000000);  <waiting ...>

-- Wait until we receive everything.
SELECT gp_wait_until_triggered_fault('check_dispatch_result_end', 1, dbid) FROM gp_segment_configuration WHERE role = 'p' AND content = -1;
 gp_wait_until_triggered_fault 
-------------------------------
 Success:                      
(1 row)

-- Remember the amount of memory Vmtracker thinks we are using.
CREATE TABLE vmtracker_memory AS SELECT m.vmem_mb AS mb FROM session_state.session_level_memory_consumption m WHERE segid = -1 AND m.query = 'SELECT count(*) FROM gp_mock_cdbdispatchcommand(1000000);' LIMIT 1;
CREATE 1

-- Retrieve the actual amount memory that is used by the backend under load.
! psql -At -d isolation2resgrouptest -c "CREATE TABLE process_memory AS SELECT $(ps -o rss= -p $(psql -At -d isolation2resgrouptest -c 'SELECT pid FROM process_pid')) AS kb;";
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'kb' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
SELECT 1


-- Compare both values, allow 30 MB error threshold for Vmtracker.
SELECT p.kb / 1024 - v.mb < 30 AS "is in threshold" FROM process_memory p, vmtracker_memory v;
 is in threshold 
-----------------
 t               
(1 row)

SELECT gp_inject_fault('check_dispatch_result_end', 'reset', dbid) FROM gp_segment_configuration WHERE role = 'p' AND content = -1;
 gp_inject_fault 
