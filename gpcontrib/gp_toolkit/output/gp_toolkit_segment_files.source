-- partitioned table
CREATE TABLE ptable (id int, a int, b int)
TABLESPACE ts_test
DISTRIBUTED BY (id)
PARTITION BY RANGE (a)
    SUBPARTITION BY RANGE (b)
        SUBPARTITION TEMPLATE (START (1) END (3) EVERY (1))
    (START (1) END (3) EVERY (1));
INSERT INTO ptable
    SELECT i+1, mod(i/4,2)+1, mod(i/2,2)+1
    FROM generate_series(0,100) AS i;
SELECT * FROM _show_files_current;
         table_name          | content | relamname | relispartition 
-----------------------------+---------+-----------+----------------
 ptable_tbloid_prt_1_2_prt_1 |       0 | heap      | t
 ptable_tbloid_prt_1_2_prt_1 |       1 | heap      | t
 ptable_tbloid_prt_1_2_prt_1 |       2 | heap      | t
 ptable_tbloid_prt_1_2_prt_2 |       0 | heap      | t
 ptable_tbloid_prt_1_2_prt_2 |       1 | heap      | t
 ptable_tbloid_prt_1_2_prt_2 |       2 | heap      | t
 ptable_tbloid_prt_2_2_prt_1 |       0 | heap      | t
 ptable_tbloid_prt_2_2_prt_1 |       1 | heap      | t
 ptable_tbloid_prt_2_2_prt_1 |       2 | heap      | t
 ptable_tbloid_prt_2_2_prt_2 |       0 | heap      | t
 ptable_tbloid_prt_2_2_prt_2 |       1 | heap      | t
 ptable_tbloid_prt_2_2_prt_2 |       2 | heap      | t
(12 rows)

DROP TABLE ptable;
DROP TABLESPACE ts_test;
-- Test paths
\! rm -rf @testtablespace@ && mkdir @testtablespace@
CREATE TABLESPACE ts_test LOCATION '@testtablespace@';
CREATE TABLE t(id int) TABLESPACE ts_test DISTRIBUTED BY (id);
INSERT INTO t SELECT generate_series(1,100);
CREATE TABLE t_default(id int) DISTRIBUTED BY (id);
INSERT INTO t_default SELECT generate_series(1,100);
-- tablespace location
SELECT
    files.table_name,
    files.content,
    files.table_tablespace,
    CASE
        WHEN 'pg_default' = files.table_tablespace AND
             files.tablespace_location = gpconf.datadir || '/base'
        THEN '<SEGMENT_BASE_DIR>/base'
        WHEN 'pg_global' = files.table_tablespace AND
             files.tablespace_location = gpconf.datadir || '/global'
        THEN '<SEGMENT_BASE_DIR>/global'
        WHEN 'ts_test' = files.table_tablespace AND
             files.tablespace_location = '@testtablespace@'
        THEN '<TEST_TABLESPACE_LOCATION_DIR>'
        ELSE files.tablespace_location
    END AS tablespace_location
FROM (SELECT content, table_name, relamname, table_tablespace,
             tablespace_location, segment_preferred_role::CHAR(1)
      FROM gp_toolkit.gp_db_files_current
      ) files
JOIN gp_segment_configuration gpconf ON
        gpconf.content = files.content AND
        gpconf.preferred_role = files.segment_preferred_role
WHERE table_name IN ('t_default', 'gp_segment_configuration','t')
ORDER BY 1, 2;
        table_name        | content | table_tablespace |      tablespace_location       
--------------------------+---------+------------------+--------------------------------
 gp_segment_configuration |       0 | pg_global        | <SEGMENT_BASE_DIR>/global
 gp_segment_configuration |       1 | pg_global        | <SEGMENT_BASE_DIR>/global
 gp_segment_configuration |       2 | pg_global        | <SEGMENT_BASE_DIR>/global
 t                        |       0 | ts_test          | <TEST_TABLESPACE_LOCATION_DIR>
 t                        |       1 | ts_test          | <TEST_TABLESPACE_LOCATION_DIR>
 t                        |       2 | ts_test          | <TEST_TABLESPACE_LOCATION_DIR>
 t_default                |       0 | pg_default       | <SEGMENT_BASE_DIR>/base
 t_default                |       1 | pg_default       | <SEGMENT_BASE_DIR>/base
 t_default                |       2 | pg_default       | <SEGMENT_BASE_DIR>/base
(9 rows)

-- file paths (make file paths list and check that they exist)
\pset tuples_only on
\pset format unaligned
\o @testtablespace@/.expected_files
SELECT file
FROM gp_toolkit.gp_db_files_current
WHERE table_name IN ('t_default', 'gp_segment_configuration','t')
ORDER BY content;
\o
\pset tuples_only off
\pset format aligned
\! bash -c 'missing=0; while IFS= read -r f; do if [ -f "$f" ]; then printf "File exists\n"; else printf "MISSING: %s\n" "$f"; missing=1; fi; done < "@testtablespace@/.expected_files"; [ $missing -eq 0 ] && echo "FS CHECK: OK" || (echo "FS CHECK: FAIL"; exit 1)'
File exists
