#!/usr/bin/env python3

from gppylib.mainUtils import getProgramName

try:
    from gppylib.gparray import GpArray, Segment
    from gppylib.gpparseopts import OptParser, OptChecker
    from gppylib.gplog import *
    from gppylib.db import dbconn
    from gppylib.userinput import *
    from gppylib.system.environment import GpCoordinatorEnvironment
    from gppylib.system import configurationInterface, configurationImplGpdb
    from gprebalance_modules.utils import *
    import gprebalance_modules.cli as cli
    from gprebalance_modules.rebalance import GPRebalance
except ImportError as e:
    sys.exit('ERROR: Cannot import modules.  Please check that you have sourced greenplum_path.sh.  Detail: ' + str(e))

DBNAME = 'postgres'

EXECNAME = os.path.split(__file__)[-1]

gp_rebalance = None


def sig_handler(sig, arg):
    if gp_rebalance is not None:
        gp_rebalance.shutdown()

    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    signal.signal(signal.SIGHUP, signal.SIG_DFL)

    # raise sig
    os.kill(os.getpid(), sig)


def main(options, args, parser):
    try:
        signal.signal(signal.SIGTERM, sig_handler)
        signal.signal(signal.SIGHUP, sig_handler)

        logger = get_default_logger()
        setup_tool_logging(EXECNAME, getLocalHostname(), getUserName())

        options, args = cli.validate_options(options, args)
        try:
            options.coordinator_data_directory = get_coordinatordatadir()
            options.gphome = get_gphome()
        except GpError as e:
            logger.error(e)
            sys.exit(1)

        if not os.path.exists(options.coordinator_data_directory):
            logger.error('Coordinator data directory %s does not exist.' %
                         options.coordinator_data_directory)
            sys.exit(1)

        if options.verbose:
            enable_verbose_logging()

        gpEnv = GpCoordinatorEnvironment(
            options.coordinator_data_directory, True)
        configurationInterface.registerConfigurationProvider(
            configurationImplGpdb.GpConfigurationProviderUsingGpdbCatalog())
        configurationInterface.getConfigurationProvider(
        ).initializeProvider(gpEnv.getCoordinatorPort())

        dburl = dbconn.DbURL(dbname=DBNAME, port=gpEnv.getCoordinatorPort())
        # check parallel execution of other cluster utilities
        check_running_gputils(dburl, options.coordinator_data_directory)
        # create pid file
        create_pid_file(options.coordinator_data_directory)

        gp_rebalance = GPRebalance(logger,
                                   dburl,
                                   options.filename,
                                   options.mirroring)

        # dump existing hosts configuration
        if options.genconf:
            outputfile = os.getcwd() + "/gprebalance_hosts.yaml"
            logger.info('Generating hosts config in %s' % outputfile)
            with open(outputfile, 'w') as fp:
                fp.write(gp_rebalance.dump_hosts_info())
            sys.exit(0)

        if not gp_rebalance.needs_balance(options.silent, options.allow_mirrorless):
            logger.info('Cluster is already balanced')
        logger.info('Validation passed. Preparing rebalance...')
        logger.info('Exiting...')
        sys.exit(0)
    except Exception as e:
        logger.error(f'gprebalance failed: {e} \n\nExiting...')
        sys.exit(1)
    except KeyboardInterrupt:
        signal.signal(signal.SIGINT, signal.SIG_IGN)

        if gp_rebalance is not None:
            gp_rebalance.shutdown()

        # Re-enabled SIGINT
        signal.signal(signal.SIGINT, signal.default_int_handler)

        sys.exit('\nUser Interrupted')
    finally:
        remove_pid_file(get_coordinatordatadir())


if __name__ == '__main__':
    options, args, parser = cli.parseargs()
    main(options, args, parser)
